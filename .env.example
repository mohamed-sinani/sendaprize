# ------------------------------------------------------------------
# SendAPrize configuration
# Copy this file to .env and fill in your values.
# ------------------------------------------------------------------

# --- GitHub credentials (REQUIRED for GitHub-as-database mode) ---
# 1. Create a GitHub account
# 2. Create a repository (e.g. "sendaprize") — keep it empty or with a README
# 3. Create a Personal Access Token (fine-grained, repo contents read/write):
#    GitHub -> Settings -> Developer settings -> Personal access tokens ->
#    Tokens (classic) -> Generate new token -> scope: "repo"
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Commit engine mode ---
# DEMO       = every single interaction creates its own commit (most GitHub activity)
# PRODUCTION = queue events and batch them into one commit per 50 events / 60s
COMMIT_MODE=DEMO
BATCH_SIZE=50
BATCH_FLUSH_SECONDS=60

# --- Heartbeat (daily activity report commits) ---
# AUTO  = server writes a daily report commit on a schedule (hours between runs)
# manual = trigger via POST /api/heartbeat or a cron job
HEARTBEAT_AUTO=true
HEARTBEAT_HOURS=24

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000

# --- Local fallback (only used if GITHUB_TOKEN is missing, for previewing UI) ---
LOCAL_DATA_DIR=./local-data
